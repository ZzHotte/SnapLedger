# 复制这个文件为 .env，然后把下面的占位符换成真实值。
# .env 本身不要提交到 git（见 .gitignore），.env.example 才是提交进仓库的模板。

# --- 数据库（Neon Postgres）---
# 去 Neon Console -> 你的项目 SnapLedger -> Dashboard 页面的 "Connect" 按钮里复制
# Connection string，格式大致是：
# postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- AI（小票提取 + 理财建议）---
# aistudio.google.com -> Get API key 生成（有免费额度，个人项目量级基本够用，超额再去
# Google Cloud Console 关联的项目里开 Billing）
# 小票提取建议用 Gemini Flash（便宜量大够用），理财建议/月度分析用 Gemini Pro（推理更强）
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 小票图片存储（Cloudinary）---
# cloudinary.com 注册（免费，不需要绑卡）-> Dashboard 首页就能看到这三个值
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google 登录（OAuth）---
# Google Cloud Console -> 新建项目 -> OAuth consent screen（User type: External，留在 Testing 状态即可，
# 把要邀请的好友邮箱加进"测试用户"名单，不用走 Google 应用审核）-> Credentials -> OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# 本地开发先用这个占位，部署后再加一条生产环境的 redirect URI 到 Google Cloud Console 里
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Google 登录成功后后端会重定向回前端这个地址（带上 token），CORS 也用这个值
FRONTEND_URL=http://localhost:3000
# 前端调用后端 API 的地址（NEXT_PUBLIC_ 前缀会被打进浏览器端 bundle）
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- 缓存/定时任务（汇率、宏观数据）---
# docker compose 里 redis 服务名就叫 redis，容器间通信用服务名而不是 localhost
REDIS_URL=redis://redis:6379

# --- Auth ---
# FastAPI 自己签发 JWT 用的密钥，本地开发随便填，部署前换成一个随机长字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
